# 環境変数・秘密情報（絶対にGitに含めない）
.env
.streamlit/secrets.toml

# Python 仮想環境（ローカル専用）
.venv/
__pycache__/
*.pyc
*.pyo

# 入出力データ（生成ファイル・音声ファイル）
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Whisper モデルキャッシュ（容量大）
models/

# IDE
.vscode/
.idea/

# ログ（ローカル実行ログ）
*.log

# テンプレートバックアップ
config/templates/_backup/

# Windows 固有
Thumbs.db
Desktop.ini
